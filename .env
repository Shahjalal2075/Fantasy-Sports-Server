JWT_EXPIRES_IN="7d"
PORT=5000

# Comma-separated list of allowed origins for CORS, e.g.
# "https://your-admin-panel.vercel.app,https://yourapp.com"
# Leave unset during development to allow all origins.
CORS_ORIGIN=""

# Max pg connections PER function/process. Keep at 1 for serverless
# (Vercel). Raise to ~5-10 if deploying to a single always-on process
# (Render, a VPS, Docker).
PRISMA_POOL_MAX=1

# Live score integration — see README "Live Score Integration" section
# mock = generates realistic fake stats for testing the full pipeline (default)
# http = calls a real provider via src/services/providers/httpProvider.ts
SPORTS_DATA_PROVIDER="mock"
SPORTS_API_KEY=""
SPORTS_API_BASE_URL=""

