# Only needed if DATABASE_URL is a POOLED connection string (e.g. Neon's
# "-pooler" endpoint, Supabase's pooler). Migrations run against this
# DIRECT (unpooled) URL instead. If you only have one connection string,
# leave this unset — prisma.config.ts falls back to DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://neondb_owner:npg_DZFA1GM4irCk@ep-winter-dream-az96avv2.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
