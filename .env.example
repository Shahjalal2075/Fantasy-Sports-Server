# Neon: use the POOLED connection string here (hostname contains "-pooler")
DATABASE_URL="postgresql://user:password@host-pooler.region.neon.tech/dbname?sslmode=require"
# Migrations need the DIRECT (non-pooled) string
DIRECT_DATABASE_URL="postgresql://user:password@host.region.neon.tech/dbname?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# 1 for serverless, 5+ for a long-lived process (Render)
PRISMA_POOL_MAX=5

# Comma-separated list, or leave unset to allow all origins
# CORS_ORIGIN="https://admin.example.com"

# imgbb key used by POST /api/uploads/image. Kept server-side so it never
# ships inside the mobile app bundle or the admin panel's JS.
IMGBB_API_KEY="09ba25425cbfcaa1a34dd5a900472889"

# ---- Email OTP (signup verification + password reset) ----
# Gmail: requires 2-Step Verification, then a 16-character App Password
# from https://myaccount.google.com/apppasswords (paste it WITHOUT spaces).
# MAIL_FROM must use the same Gmail address — Gmail rejects addresses it
# doesn't own. See SETUP_EMAIL_OTP.md for the full walkthrough.
#
# Leave unset in development and codes print to the server log instead.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="youraddress@gmail.com"
SMTP_PASS="abcdefghijklmnop"
MAIL_FROM="Strong XI <youraddress@gmail.com>"
