// Fantasy Sports App - Database Schema (Prisma ORM 7 style)
// Sports covered: Cricket, Football
// Model: Free-to-play with a virtual, non-purchasable, non-withdrawable
// coin system (NOT real money) for contest entry + prizes.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum SportType {
  CRICKET
  FOOTBALL
}

enum MatchStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum CoinTransactionType {
  DAILY_BONUS
  CONTEST_ENTRY
  CONTEST_PRIZE
  CONTEST_REFUND
  ADMIN_BONUS
  ADMIN_FINE
  PROMO_CODE
  REFERRAL_BONUS
  GIFT_REQUEST
  GIFT_REFUND
  // Coins granted by an agent from an approved request.
  COIN_REQUEST
}

enum NotificationType {
  COIN_BONUS
  COIN_FINE
  BAN
  GENERIC
}

/**
 * Every event that can raise a notification.
 *
 * Each one is switchable from the admin panel. Turning one off stops the
 * push only — the in-app record is still written, so a user's history
 * stays complete whatever the current settings are.
 */
enum NotificationEvent {
  // Match
  MATCH_REMINDER_30
  MATCH_REMINDER_15
  MATCH_TIME_CHANGED
  NEW_CONTEST

  // Coins
  CONTEST_PRIZE
  ADMIN_BONUS
  ADMIN_FINE
  REFERRAL_BONUS
  REFERRAL_REWARD

  // Requests
  COIN_REQUEST_APPROVED
  COIN_REQUEST_DECLINED
  GIFT_APPROVED
  GIFT_CANCELLED
  GIFT_EXPIRED

  // Account
  ACCOUNT_VERIFIED
  VERIFICATION_REMOVED
  PASSWORD_RESET
  ACCOUNT_BANNED

  // Sent by hand
  CUSTOM
}

enum PushStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id               String    @id @default(uuid())
  name             String
  username         String    @unique
  email            String    @unique
  phone            String?   @unique
  passwordHash     String
  avatarUrl        String?
  // Personal details captured on the app's Edit Profile screen. Visible
  // to admins only — the app never displays them back to the user.
  dateOfBirth      DateTime?
  nidNumber        String?
  // Timestamps backing the change cooldowns: username once per 60 days,
  // avatar once per 7. Null means "never changed", so the first change
  // is always allowed.
  usernameChangedAt DateTime?
  avatarChangedAt   DateTime?
  totalPoints      Int       @default(0)
  isAdmin          Boolean   @default(false)
  // Virtual, non-purchasable, non-withdrawable in-app currency. Never
  // exchanged for real money in either direction — see CoinTransaction.
  // Total balance. Kept as the sum of the two buckets below so every
  // existing read — profile, leaderboard, admin — keeps working
  // unchanged. All three are written together inside one transaction.
  coins            Int       @default(0)
  // Bonuses, promo codes, referrals and admin grants. Spendable on
  // contests, but never redeemable for a gift.
  depositCoins     Int       @default(0)
  // Won from contests. This is the only balance a gift can be requested
  // against, which is what stops someone cashing out free coins.
  withdrawableCoins Int      @default(0)
  lastDailyBonusAt DateTime?
  isBanned         Boolean   @default(false)
  bannedReason     String?
  bannedAt         DateTime?
  // The referral code THEY entered at signup (kept as typed, for audit).
  referredByCode   String?
  // Their OWN code to share — generated at signup, never changes.
  referralCode     String    @unique
  // Resolved from referredByCode at signup. Self-relation, so a user's
  // invitees are reachable as `referrals`.
  referredById     String?
  referredBy       User?     @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]    @relation("UserReferrals")
  // The inviter's reward is paid only once: after this user is verified
  // AND has joined their first paid contest.
  referralRewardPaid Boolean @default(false)
  // The invitee's own joining bonus, paid when an admin verifies them.
  referralSignupBonusPaid Boolean @default(false)
  // Blue tick, set by an admin.
  isVerified       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userTeams     UserTeam[]
  entries       ContestEntry[]
  coinLedger    CoinTransaction[]
  notifications Notification[]
  promoCodeClaims PromoCodeClaim[]
  activeSessions  ActiveSession[]
  giftRequests    GiftRequest[]
  coinRequests    CoinRequest[]
  pushTokens      PushToken[]

  // User's own switch. Off means no pushes at all, whatever the admin
  // settings say — Play Store expects this to exist.
  pushEnabled     Boolean @default(true)

  @@map("users")
}

// Full audit trail of every coin movement. Coins have no real-world value
// and are never purchasable or redeemable — this ledger exists purely for
// transparency/debugging, not for any financial reconciliation.
model CoinTransaction {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         CoinTransactionType
  amount       Int                 // positive = credit, negative = debit
  balanceAfter Int
  contestId    String?             // set for CONTEST_ENTRY / CONTEST_PRIZE
  reason       String?             // admin-entered reason for ADMIN_BONUS / ADMIN_FINE
  createdAt    DateTime            @default(now())

  @@map("coin_transactions")
}

// In-app alert shown to a user when an admin adjusts their coins or bans them.
model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String
  coinAmount Int?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@map("notifications")
}

// Single-row app-wide settings (currently just the daily bonus amount).
model AppSettings {
  id               Int    @id @default(1)
  dailyBonusAmount Int    @default(100)

  // Gift redemption. Requests below the minimum are rejected outright,
  // and a pending request auto-refunds after giftRequestExpiryDays.
  giftRequestsEnabled   Boolean @default(true)
  giftRequestMinCoins   Int     @default(1000)
  giftRequestExpiryDays Int     @default(10)
  // A user may submit one request per this many hours.
  giftRequestCooldownHours Int  @default(24)
  // Shown on the app's request screen so users know what to expect.
  giftRequestNote       String  @default("Our team reviews every request. If yours isn't selected, your coins are returned in full.")

  // Coin requests: where the Messenger and Telegram icons point, and the
  // limits the request form enforces.
  coinRequestEnabled     Boolean @default(true)
  coinRequestMessenger   String  @default("")
  coinRequestTelegram    String  @default("")
  coinRequestMinCoins    Int     @default(10)
  // How many unresolved requests one user may have at a time. Held
  // requests count, or parking them would sidestep the limit.
  coinRequestMaxPending  Int     @default(3)
  coinRequestNote        String  @default("")

  // Shown as the large icon inside a notification. The small status-bar
  // icon is a monochrome silhouette bundled at build time — Android
  // strips colour from it, so it can't be set from here.
  notificationLogoUrl String @default("")

  // Deposit isn't supported — coins can't be bought. This is the copy
  // and call-to-action shown when someone taps Deposit anyway, editable
  // so support channels can change without an app release.
  depositMessage    String @default("Sorry, this app does not support deposit. If you have any query, contact our support.")
  depositButtonText String @default("Contact Support")
  depositButtonLogo String @default("")
  depositButtonUrl  String @default("")

  // Referral rewards. The invitee is credited the moment they sign up
  // with a valid code; the inviter is credited only once that invitee
  // joins their first paid contest, which is what stops someone farming
  // coins with throwaway accounts.
  referralSignupBonus  Int @default(100)
  referralInviterBonus Int @default(100)

  // Legal copy, written from the admin panel and rendered in the app.
  // Stored as text with light markdown (## headings, - bullets) so it can
  // be updated without shipping a new build.
  privacyPolicy      String @default("")
  termsAndConditions String @default("")
  legalUpdatedAt     DateTime?

  // Banners now live in their own table (see Banner) so there can be
  // several, each with its own tap-through link.

  // Maintenance mode. When on, the app shows a blocking modal on launch
  // and nobody gets past the first screen.
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("We're doing some maintenance. Please check back shortly.")

  // Forced / suggested updates. The app sends its own version to
  // /api/app-config and the server decides which of the two it gets:
  //   version < minSupportedVersion -> blocking "must update" modal
  //   version < latestAppVersion    -> dismissible "update available"
  // Versions are dotted numeric strings ("1.4.2"), compared part by part.
  latestAppVersion    String @default("1.0.0")
  minSupportedVersion String @default("1.0.0")
  updateUrl           String @default("")
  updateMessage       String @default("A new version of Strong XI is available.")

  // Support details shown on the app's Contact Us screen. Kept here so
  // they can be changed without shipping a new build.
  supportEmail     String @default("")
  supportPhone     String @default("")
  supportWhatsapp  String @default("")
  supportFacebook  String @default("")
  supportHours     String @default("")

  updatedAt DateTime @updatedAt @default(now())

  @@map("app_settings")
}

// A user's request to redeem coins for a physical gift.
//
// Coins are debited the moment the request is made and held against this
// row. Any outcome other than APPROVED refunds them in full, including
// the automatic expiry — so a user can never lose coins to a request
// that nobody ever looked at.
model GiftRequest {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinAmount Int
  status     GiftRequestStatus @default(PENDING)

  // Required when approving — the user sees this in their history so
  // they can follow the delivery.
  trackingId String @default("")
  // Required when cancelling, and shown to the user with their refund.
  cancelReason String @default("")

  // How to reach the user about the gift. The method's name and logo are
  // SNAPSHOT here rather than only referenced, so deleting a contact
  // method later doesn't blank out old requests.
  contactMethodId   String?
  contactMethod     ContactMethod? @relation(fields: [contactMethodId], references: [id], onDelete: SetNull)
  contactMethodName String  @default("")
  contactMethodLogo String  @default("")
  contactNumber     String  @default("")

  // A pending request auto-cancels and refunds after this moment, so
  // coins are never held indefinitely by an oversight.
  expiresAt  DateTime
  resolvedAt DateTime?
  // Which admin approved or cancelled it.
  resolvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("gift_requests")
}

// A saved contest shape, not tied to any match.
//
// The same few contests get created for every fixture — a mega, a head
// to head, a small paid one. Filling the same numbers in each time is
// where mistakes creep into prize tables, so they're stored once and
// applied.
model ContestPreset {
  id   String @id @default(uuid())
  name String

  maxEntries Int @default(10000)
  entryCost  Int @default(0)

  /** Same shape as Contest.prizeDistribution: [{ rank, coins }]. */
  prizeDistribution Json @default("[]")

  /** Optional note for the admin — never shown to users. */
  description String @default("")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("contest_presets")
}

// A person who reviews coin requests and decides which to grant.
//
// Shown to the user before they submit, so they know who will be reading
// their reason. Managed entirely from the admin panel.
model RequestAgent {
  id     String @id @default(uuid())
  name   String
  logoUrl String @default("")
  // How to reach them — "WhatsApp", "Telegram", and so on.
  method String @default("")
  // Displayed with a copy button on the instructions screen.
  number String @default("")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  requests CoinRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("request_agents")
}

// A code that adds a bonus to an approved coin request.
//
// The bonus is only ever paid on approval: a coupon applied to a request
// that gets rejected is worth nothing, which is why the amount is
// recomputed at approval time rather than trusted from the request.
model CoinCoupon {
  id   String @id @default(uuid())
  code String @unique

  bonusType  CouponBonusType @default(PERCENTAGE)
  // Coins when FIXED, percent of the request when PERCENTAGE.
  bonusValue Int             @default(0)

  // The request has to fall inside this range for the code to apply.
  minCoins Int @default(0)
  // 0 means no upper limit.
  maxCoins Int @default(0)

  expiresAt DateTime?
  isActive  Boolean   @default(true)

  requests CoinRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("coin_coupons")
}

// A user asking an agent for coins.
//
// Not a purchase: no money changes hands. The user states an amount and
// a reason, and an agent decides. Most requests are refused.
model CoinRequest {
  id     String            @id @default(uuid())
  userId String
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status CoinRequestStatus @default(PENDING)

  // What they asked for, the coupon bonus on top, and the sum. All three
  // are stored so the figures a user saw can never drift.
  coinAmount  Int
  bonusAmount Int @default(0)
  totalAmount Int

  // Up to 16 characters, as shown on the form.
  reason String @default("")

  // Which agent they chose. Name, logo and method are snapshotted so an
  // agent being edited or removed later doesn't rewrite history.
  agentId     String?
  agent       RequestAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentName   String        @default("")
  agentLogo   String        @default("")
  agentMethod String        @default("")
  agentNumber String        @default("")

  couponId   String?
  coupon     CoinCoupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String      @default("")

  // Shown to the user with the decision.
  adminNote  String    @default("")
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("coin_requests")
}

// One device that can receive push notifications.
//
// Keyed by the Expo token rather than the user: reinstalling gives a new
// token, and the same device can be handed to a different account.
model PushToken {
  id     String @id @default(uuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform String @default("android")
  // Cleared when Expo reports the device is gone, rather than deleted,
  // so a reinstall on the same device doesn't look like a new user.
  isActive Boolean @default(true)

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, isActive])
  @@map("push_tokens")
}

// Whether a given event sends a push, and the artwork it carries.
model NotificationSetting {
  event   NotificationEvent @id
  /** Whether this event sends a push at all. */
  enabled Boolean           @default(true)

  /**
   * Whether it also lands in the app's notification list.
   *
   * Separate from `enabled` because the two answer different questions:
   * a match reminder is worth interrupting someone for but pointless to
   * keep, while a prize needs to stay findable long after the push has
   * been swiped away.
   */
  saveInApp Boolean @default(true)

  /**
   * The admin's own wording. Blank means use the built-in text.
   *
   * Placeholders like {fixture} or {coins} are filled at send time; each
   * event supports a different set, listed in the admin panel.
   */
  title String @default("")
  body  String @default("")

  updatedAt DateTime @updatedAt

  @@map("notification_settings")
}

// A record of what was sent, to how many, and how it went.
//
// Without this there's no way to know whether notifications are actually
// arriving — a push that silently fails looks exactly like one nobody
// tapped.
model PushLog {
  id    String            @id @default(uuid())
  event NotificationEvent

  title   String
  body    String
  /** Opened when the notification is tapped. Optional. */
  url     String @default("")
  imageUrl String @default("")

  // Null for a broadcast.
  targetUserId String?

  recipients Int        @default(0)
  delivered  Int        @default(0)
  failed     Int        @default(0)
  status     PushStatus @default(QUEUED)
  error      String     @default("")

  /** True for an admin's test send to their own device. */
  isTest Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("push_logs")
}

// A way for the admin to reach a user about their gift — WhatsApp,
// Telegram, and so on. Managed entirely from the admin panel so new
// channels don't need a code change.
model ContactMethod {
  id        String  @id @default(uuid())
  // Shown to the user exactly as typed, e.g. "WhatsApp".
  name      String
  logoUrl   String  @default("")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  giftRequests GiftRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("contact_methods")
}

// A home-screen banner. Several can be active at once, in which case the
// app cycles through them as a slider.
model Banner {
  id       String @id @default(uuid())
  imageUrl String
  // Optional tap-through target. Blank means the banner is decorative
  // and taps do nothing.
  linkUrl  String @default("")
  // Shown to admins so a banner can be identified in the list; never
  // displayed in the app.
  title    String @default("")
  // Lower numbers appear first in the slider.
  sortOrder Int    @default(0)
  // Lets a banner be parked without deleting it (and losing the image).
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("banners")
}

// One row per device that has the app open. Upserted on each heartbeat,
// so "who's online right now" is just a count of rows whose lastSeenAt
// falls inside the liveness window — no cron job, no websockets.
model ActiveSession {
  id         String   @id @default(uuid())
  // Stable per install; lets us count logged-out visitors too.
  deviceId   String   @unique
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform   String   @default("")
  appVersion String   @default("")
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([lastSeenAt])
  @@map("active_sessions")
}

// Hourly rollup powering the admin traffic graph. Written by the same
// heartbeat that touches ActiveSession, so history accumulates on its
// own rather than needing a scheduled job.
model VisitorStat {
  id             String   @id @default(uuid())
  // Start of the hour this bucket covers, in UTC.
  bucketStart    DateTime @unique
  // Highest simultaneous device count seen during the hour.
  peakConcurrent Int      @default(0)
  // Distinct devices seen at any point during the hour.
  uniqueDevices  Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("visitor_stats")
}

// A reusable Team (e.g. "India", "Bangladesh", "Manchester United").
// Created once by admin, then picked from dropdowns when creating matches
// and players — instead of retyping free-text team names every time.
model Team {
  id        String    @id @default(uuid())
  name      String
  shortName String
  // hasLogo=false -> logoUrl locked to "" (empty string).
  // hasLogo=true  -> logoUrl is required and must be a real URL.
  hasLogo   Boolean   @default(false)
  logoUrl   String    @default("")
  sport     SportType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  players        Player[]
  matchesAsTeamA Match[]  @relation("MatchTeamA")
  matchesAsTeamB Match[]  @relation("MatchTeamB")
  innings        MatchInnings[]

  @@map("teams")
}

// A reusable Player belonging to a Team (e.g. "Shakib Al Hasan" -> Bangladesh).
// Created once in the team's catalog, then picked into individual matches
// via MatchPlayer — not recreated per match.
model Player {
  id          String  @id @default(uuid())
  name        String
  teamId      String
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Role differs by sport: Cricket -> WK/BAT/AR/BOWL, Football -> GK/DEF/MID/FWD
  role        String
  creditValue Float   @default(8.0) // fantasy "price" used for the 100-credit budget rule
  // hasPhoto=false -> imageUrl locked to "" (empty string), no photo shown.
  // hasPhoto=true  -> imageUrl is required and must be a real URL.
  hasPhoto    Boolean @default(false)
  imageUrl    String  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  matchEntries MatchPlayer[]

  @@map("players")
}

model Match {
  id             String      @id @default(uuid())
  sport          SportType
  teamAId        String
  teamA          Team        @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamBId        String
  teamB          Team        @relation("MatchTeamB", fields: [teamBId], references: [id])
  tournamentName String
  // Must match a PointSystem.format for this sport once one is configured.
  format         String
  venue          String?
  startTime      DateTime
  status         MatchStatus @default(UPCOMING)
  // Lock time = when team selection closes (usually = startTime)
  lockTime       DateTime
  // Set every time an admin runs "Calculate points". The app shows it as
  // the leaderboard's "Last Updated" stamp, so users see when the numbers
  // last actually moved rather than when they opened the screen.
  pointsCalculatedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  matchPlayers MatchPlayer[]
  innings      MatchInnings[]
  liveLink     MatchLiveLink?
  userTeams    UserTeam[]
  contests     Contest[]

  @@map("matches")
}

// A Player's participation + raw performance stats in ONE specific match.
// This is what gets added via "Add Player" inside a match (picked from the
// two teams' catalogs), and what the manual "Sync Live Score" scorecard
// form fills in. Points are computed from these raw stats using the
// Binds one match to a match in the separate live-score service.
//
// The two systems share no database and no code — they speak only over
// HTTP, authenticated with a shared key. This row is the fantasy side's
// record of that pairing, kept here rather than in the live service so
// the admin panel can show connection state without depending on the
// live service being up.
model MatchLiveLink {
  id      String @id @default(uuid())
  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Short pairing code, generated here and typed into the live panel.
  code String @unique

  // The live service's own id for the match. Null until it connects.
  liveMatchId String?
  // Free text from the live side, purely so an admin can confirm the
  // right fixture was paired.
  liveLabel   String  @default("")

  connectedAt DateTime?
  // When a scorecard was last pushed in.
  lastScoreAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("match_live_links")
}

// Binds one MatchPlayer to a named player on the live side.
//
// The code is the identity, not the name. Names are only used to make
// the first match automatically; once a code exists the pairing survives
// a refetch, a renamed player, or two players sharing a name.
model PlayerLiveLink {
  id            String      @id @default(uuid())
  matchPlayerId String      @unique
  matchPlayer   MatchPlayer @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)

  // Short code, unique within the match.
  code String

  // The live side's name for this player, as last seen.
  liveName String @default("")
  // True only once the live service has confirmed this pairing — that
  // is, it reported a player carrying this code.
  //
  // Defaults to FALSE on purpose. A code an admin types in is a claim,
  // not a connection: until the live side sends it back, nothing is
  // actually paired, and showing "connected" would be a lie. A refetch
  // that drops someone also flips this to false while keeping the code,
  // so re-selection reconnects instantly.
  isActive Boolean @default(false)

  // Set automatically by name, or entered by an admin to correct a
  // mismatch. Shown in the panel so a wrong pairing can be spotted.
  matchedAutomatically Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("player_live_links")
}

// One player's stats for a single innings.
//
// Test cricket scores each innings separately: a duck in the first and
// eighty in the second are two distinct events, and rolling them into a
// match total would erase the duck penalty and hand out a milestone
// bonus that wasn't earned. Points are therefore computed per innings
// and summed.
//
// MatchPlayer keeps the match totals — the sum of these rows — so
// everything that already reads a player's aggregate stats, and every
// UserTeamPlayer that points at them, keeps working untouched.
model MatchPlayerInnings {
  id            String      @id @default(uuid())
  matchPlayerId String
  matchPlayer   MatchPlayer @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)

  // 1-2 for limited overs, 1-4 for Test.
  inningsNumber Int

  // Points earned in this innings alone.
  points Float @default(0)

  // ---- Batting ----
  runs       Int     @default(0)
  ballsFaced Int     @default(0)
  fours      Int     @default(0)
  sixes      Int     @default(0)
  isOut      Boolean @default(false)

  // ---- Bowling ----
  ballsBowled        Int @default(0)
  dotBalls           Int @default(0)
  maidens            Int @default(0)
  runsConceded       Int @default(0)
  wickets            Int @default(0)
  wicketsBowledOrLBW Int @default(0)

  // ---- Fielding (cricket) ----
  catches         Int @default(0)
  runOutsDirect   Int @default(0)
  runOutsIndirect Int @default(0)
  stumpings       Int @default(0)

  // ---- Football ----
  minutesPlayed   Int     @default(0)
  goals           Int     @default(0)
  assists         Int     @default(0)
  cleanSheet      Boolean @default(false)
  yellowCards     Int     @default(0)
  redCards        Int     @default(0)
  ownGoals        Int     @default(0)
  penaltiesSaved  Int     @default(0)
  penaltiesMissed Int     @default(0)
  saves           Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchPlayerId, inningsNumber])
  @@index([matchPlayerId])
  @@map("match_player_innings")
}

// A team's total for one innings — the scoreboard line the app shows
// above the leaderboard ("BAN 164/5 (20.0)").
//
// Stored per innings rather than per match because Test cricket has up
// to four: each side bats twice. Limited-overs matches simply use
// innings 1 and 2.
model MatchInnings {
  id      String @id @default(uuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  // Which side batted. Must be one of the match's two teams.
  teamId  String
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // 1-2 for limited overs, 1-4 for Test.
  inningsNumber Int

  runs    Int @default(0)
  wickets Int @default(0)
  // Stored as balls so partial overs are exact — 19.4 overs is 118
  // balls, which a decimal "19.4" can't represent without rounding bugs.
  balls   Int @default(0)

  // Test innings often end early by choice rather than by wickets.
  isDeclared Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per innings number per match.
  @@unique([matchId, inningsNumber])
  @@index([matchId])
  @@map("match_innings")
}

// PointSystem configured for the match's (sport, format).
model MatchPlayer {
  id        String  @id @default(uuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // Defaults to FALSE: adding a player to a match only means they're in
  // the squad. An admin flips this on once the real playing XI is
  // announced, so the app can show who's confirmed.
  isPlaying Boolean @default(false)
  points    Float   @default(0)    // computed from raw stats + PointSystem

  // ---- Batting ----
  runs       Int     @default(0)
  ballsFaced Int     @default(0)
  fours      Int     @default(0)
  sixes      Int     @default(0)
  isOut      Boolean @default(false)

  // ---- Bowling ----
  ballsBowled       Int @default(0)
  dotBalls          Int @default(0)
  maidens           Int @default(0)
  runsConceded      Int @default(0)
  wickets           Int @default(0)
  wicketsBowledOrLBW Int @default(0) // subset of `wickets` that were Bowled or LBW (extra bonus)

  // ---- Fielding (cricket) ----
  catches         Int @default(0)
  runOutsDirect   Int @default(0)
  runOutsIndirect Int @default(0)
  stumpings       Int @default(0)

  // ---- Football ----
  minutesPlayed   Int     @default(0)
  goals           Int     @default(0)
  assists         Int     @default(0)
  cleanSheet      Boolean @default(false)
  yellowCards     Int     @default(0)
  redCards        Int     @default(0)
  ownGoals        Int     @default(0)
  penaltiesSaved  Int     @default(0)
  penaltiesMissed Int     @default(0)
  saves           Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userTeamSelections UserTeamPlayer[]
  innings            MatchPlayerInnings[]
  liveLink           PlayerLiveLink?

  @@unique([matchId, playerId])
  @@map("match_players")
}

model UserTeam {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId       String
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamName      String   @default("My Team")
  captainId     String   // MatchPlayer.id
  viceCaptainId String   // MatchPlayer.id
  totalPoints   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  players UserTeamPlayer[]
  entries ContestEntry[]

  @@unique([userId, matchId, teamName])
  @@map("user_teams")
}

model UserTeamPlayer {
  id            String      @id @default(uuid())
  userTeamId    String
  userTeam      UserTeam    @relation(fields: [userTeamId], references: [id], onDelete: Cascade)
  matchPlayerId String
  matchPlayer   MatchPlayer @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)

  @@unique([userTeamId, matchPlayerId])
  @@map("user_team_players")
}

// A Contest is a leaderboard pool for a match. Joining costs virtual coins
// (entryCost) purely to rate-limit entries — NOT real money. Winners are
// paid out in the same virtual coins per prizeDistribution, e.g.
// [{"rank":1,"coins":500},{"rank":2,"coins":300},{"rank":3,"coins":100}].
// Coins are never purchasable or withdrawable — see User.coins.
model Contest {
  id                String   @id @default(uuid())
  matchId           String
  match             Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  name              String
  maxEntries        Int      @default(10000)
  entryCost         Int      @default(0)  // coins required to join (0 = free)
  prizeDistribution Json     @default("[]") // [{ "rank": 1, "coins": 500 }, ...]
  prizesDistributed Boolean  @default(false) // guards against double-payout
  isCancelled       Boolean  @default(false)
  createdAt         DateTime @default(now())

  entries ContestEntry[]

  @@map("contests")
}

enum CoinRequestStatus {
  PENDING
  // Parked for a decision later. Still counts against a user's pending
  // limit — otherwise held requests would pile up unbounded.
  HELD
  APPROVED
  REJECTED
}

enum CouponBonusType {
  FIXED
  PERCENTAGE
}

enum GiftRequestStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum ContestEntryStatus {
  ACTIVE
  LOCKED
  COMPLETED
}

model ContestEntry {
  id         String             @id @default(uuid())
  contestId  String
  contest    Contest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userTeamId String
  userTeam   UserTeam           @relation(fields: [userTeamId], references: [id], onDelete: Cascade)
  status     ContestEntryStatus @default(ACTIVE)
  rank       Int?
  createdAt  DateTime           @default(now())

  // A user may only enter a given contest ONCE, regardless of which of
  // their teams they use — not just once-per-team as before.
  @@unique([contestId, userId])
  @@map("contest_entries")
}

// Admin-configurable scoring rules, one row per (sport, format) — e.g.
// (CRICKET, "T20") can score differently from (CRICKET, "Test"). When a
// match is created, its `format` should match one of these. If none
// matches, the sport's default (isDefault=true) row is used.
model PointSystem {
  id        String    @id @default(uuid())
  sport     SportType
  format    String    // e.g. "T20", "ODI", "Test", "League", "Knockout"
  isDefault Boolean   @default(false)
  rules     Json      // shape depends on sport — see fantasyScoring.ts
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([sport, format])
  @@map("point_systems")
}

// Admin creates these; users claim once each. maxClaims caps total claims
// across everyone; expiresAt is set at creation (admin picks "valid for N
// days"). Coins credited are virtual — same rules as everywhere else.
model PromoCode {
  id         String   @id @default(uuid())
  code       String   @unique
  coinAmount Int
  maxClaims  Int
  expiresAt  DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  claims PromoCodeClaim[]

  @@map("promo_codes")
}

model PromoCodeClaim {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@map("promo_code_claims")
}
